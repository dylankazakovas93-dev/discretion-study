{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CandidateFeatureVector",
  "description": "Causal, direction-normalized numeric+categorical features for a coherent setup candidate. No future-derived field. `symmetric` marks whether bullish/bearish may be compared directly.",
  "type": "object",
  "properties": {
    "origin_family": {"type": "string", "symmetric": true},
    "source_timeframe": {"type": "string", "symmetric": true},
    "session": {"type": "string", "symmetric": false},
    "minutes_from_0930": {"type": "integer", "symmetric": false},
    "direction": {"type": "integer", "enum": [-1, 1], "symmetric": false},
    "entry_mode": {"type": "string", "symmetric": true},
    "continuation_or_fade": {"type": "string", "symmetric": true},
    "path_family": {"type": "string", "symmetric": true},
    "dist_to_stop_atr": {"type": ["number", "null"], "symmetric": true},
    "natural_rr": {"type": "number", "symmetric": true},
    "executed_rr": {"type": "number", "symmetric": true},
    "has_fvg": {"type": "boolean", "symmetric": true},
    "has_ifvg": {"type": "boolean", "symmetric": true},
    "has_rb": {"type": "boolean", "symmetric": true},
    "has_sweep": {"type": "boolean", "symmetric": true},
    "target_family": {"type": "string", "symmetric": true},
    "contradictory_structure": {"type": "boolean", "symmetric": true},
    "htf_alignment": {"type": "string", "symmetric": true},
    "origin_age_bars": {"type": ["integer", "null"], "symmetric": true},
    "zone_width_atr": {"type": ["number", "null"], "symmetric": true},
    "revisit_number": {"type": ["integer", "null"], "symmetric": true},
    "displacement_grade": {"type": ["string", "null"], "symmetric": true},
    "displacement_body_atr": {"type": ["number", "null"], "symmetric": true},
    "path_body_ratio": {"type": ["number", "null"], "symmetric": true},
    "favorable_close": {"type": ["number", "null"], "symmetric": true,
      "note": "already direction-normalized: positive = close in setup direction"},
    "level_family": {"type": ["string", "null"], "symmetric": true},
    "sweep_state": {"type": ["boolean", "null"], "symmetric": true},
    "vwap_side": {"type": ["integer", "null"], "symmetric": true,
      "note": "direction-normalized: +1 = price on the setup-favorable side of VWAP"},
    "nearest_vwap_band": {"type": ["string", "null"], "symmetric": true}
  }
}
